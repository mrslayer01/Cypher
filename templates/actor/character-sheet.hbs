<form class="actor-sheet" autocomplete="off">
  <header class="sheet-header">
    {{> character-header}}
  </header>

    <nav class="sheet-tabs" data-group="primary">
      <a class="item" data-tab="main">
        Main
      </a>
      <a class="item" data-tab="advancements">
        Advancements
      </a>
      <a class="item" data-tab="description">
        Description
      </a>
    </nav>

  <section class="sheet-body">
    <div class="tab main" data-group="primary" data-tab="main">
      <div class="cypher-body">

      </div>
    </div>

    <div class="tab advancements" data-group="primary" data-tab="advancements">
      <div class="cypher-advancements">

      </div>
    </div>

    <div class="tab description" data-group="primary" data-tab="description">
        <div class="description-editor">
          {{#if system.bio.charatcerDescription}}
            {{editor
              system.bio.charatcerDescription
              target="system.bio.charatcerDescription"
              button=true
              editable=true
              engine="prosemirror"
            }}
          {{else}}
            {{editor
              "<p class='placeholder'>Write your background here…</p>"
              target="system.bio.charatcerDescription"
              button=true
              editable=true
              engine="prosemirror"
            }}
          {{/if}}
        </div>
      </section>
    </div>
  </section>
</form>