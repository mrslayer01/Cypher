<div class="roll-window-container">
  <h2>
    {{rollLabel}}
  </h2>

  <div class="section">
    <label>
      <b>
        Task Difficulty
      </b>
    </label>
    <select id="difficulty">
      <option value="1">
        Simple (3)
      </option>
      <option value="2">
        Standard (6)
      </option>
      <option value="3">
        Demanding (9)
      </option>
      <option value="4">
        Difficult (12)
      </option>
      <option value="5">
        Challenging (15)
      </option>
      <option value="6">
        Intimidating (18)
      </option>
      <option value="7">
        Formidable (21)
      </option>
      <option value="8">
        Heroic (24)
      </option>
      <option value="9">
        Immortal (27)
      </option>
      <option value="10">
        Impossible (30)
      </option>
    </select>
  </div>

  <div class="section">
    <h4>
      {{gmIntrusionRange}}
    </h4>
  </div>

  <div id="liveBreakdown" class="section breakdown-open">
    <h4>
      Difficulty Breakdown
    </h4>
    <div id="liveBreakdownContent"></div>
  </div>

  {{#if showSkill}}
    <div class="section">
      <label>
        <b>
          Skill Level
        </b>
      </label>
      <select id="skill">
        <option value="0">
          Practiced
        </option>
        <option value="1">
          Trained
        </option>
        <option value="2">
          Specialized
        </option>
        <option value="-1">
          Inability
        </option>
      </select>
    </div>
  {{/if}}

  <div class="section">
    <label>
      <b>
        Assets
      </b>
    </label>
    <select id="assets">
      <option value="0">
        None
      </option>
      <option value="1">
        1 Asset
      </option>
      <option value="2">
        2 Assets
      </option>
    </select>
  </div>

  <div class="section">
    <label>
      <b>
        Effort
      </b>
    </label>
    <input type="number" id="effort" value="0" min="0" max="6" />
  </div>

  <button id="roll-button" class="roll-btn">
    Roll
  </button>
</div>