<div class="cypher-header-stats">
    {{! MIGHT }}
    <div class="stat-block">
        <div class="stat-title">
            <a class="stat-roll clickable" data-pool="might" data-tooltip="Might stat roll">
                MIGHT
            </a>
            <a class="pool-reset" data-pool="might" data-tooltip="Reset pool to max">
                <i class="fa-item fas fa-sync"></i>
            </a>
        </div>

        <!-- Current -->
        <div class="stat-max-display">
            <div class="floating max">
                <input type="number" name="system.core.pools.might.current" class="no-negative" value="{{system.core.pools.might.current}}" />
                <label>Pool</label>
            </div>
        </div>

        <!-- max + Edge -->
        <div class="stat-row">
            <div class="floating pool">
                <input type="number" name="system.core.pools.might.max" class="no-negative" value="{{system.core.pools.might.max}}" />
                <label>Max</label>
            </div>
            <span class="stat-separator">|</span>
            <div class="floating pool">
                <input type="number" name="system.core.pools.might.edge.current" class="no-negative" value="{{system.core.pools.might.edge.current}}" />
                <label>Edge</label>
            </div>
        </div>
        <!-- Defense -->
        <div class="defense-row">
            <div class="def-label"><a class="defence-roll clickable" data-pool="might" data-tooltip="Defense roll for Might">DEFENSE</a></div>

            <div class="def-grid">
                <div class="def-col">
                <span class="def-letter">I</span>
                <input class="might-inability"
                    type="radio"
                    name="mightDefense"
                    data-choice="inability"
                    data-tooltip="Inability - Increases difficulty by 1 step."
                    {{#if system.core.pools.might.defense.inability.choice}}checked{{/if}} />
                </div>

                <div class="def-col">
                <span class="def-letter">P</span>
                <input class="might-practiced"
                    type="radio"
                    name="mightDefense"
                    data-choice="practiced"
                    data-tooltip="Practiced - No adjustments to difficulty."
                    {{#if system.core.pools.might.defense.practiced.choice}}checked{{/if}} />
                </div>

                <div class="def-col">
                <span class="def-letter">T</span>
                <input class="might-trained"
                    type="radio"
                    name="mightDefense"
                    data-choice="trained"
                    data-tooltip="Trained - Decreases difficulty by 1 step."
                    {{#if system.core.pools.might.defense.trained.choice}}checked{{/if}} />
                </div>

                <div class="def-col">
                <span class="def-letter">S</span>
                <input class="might-specialized"
                    type="radio"
                    name="mightDefense"
                    data-choice="specialized"
                    data-tooltip="Specialized - Decreases difficulty by 2 steps."
                    {{#if system.core.pools.might.defense.specialized.choice}}checked{{/if}} />
                </div>
            </div>
        </div>
    </div>

