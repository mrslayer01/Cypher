<section class="cypher-header-recovery">
  <span>
    <a class="recovery-roll" data-tooltip="Click to make a recovery roll.">
      RECOVERY
    </a>
    <a class="recovery-reset" data-tooltip="Reset recovery uses">
      <i class="fa-item fas fa-sync"></i>
    </a>
  </span>

  <div class="recovery-horizontal">
    <label>
      <input
        type="checkbox"
        name="system.core.recovery.uses.oneAction"
        {{checked system.core.recovery.uses.oneAction}}
      />
      One Action
    </label>
    <label>
      <input
        type="checkbox"
        name="system.core.recovery.uses.tenMinutes"
        {{checked system.core.recovery.uses.tenMinutes}}
      />
      Ten Minutes
    </label>
    <label>
      <input type="checkbox" name="system.core.recovery.uses.oneHour" {{checked system.core.recovery.uses.oneHour}} />
      One Hour
    </label>
    <label>
      <input type="checkbox" name="system.core.recovery.uses.tenHours" {{checked system.core.recovery.uses.tenHours}} />
      Ten Hours
    </label>
  </div>
</section>