<section class="cypher-header-damage">
  <div class="damage-top-row">
    <span>
      Damage Track
      <a class="damage-reset" data-tooltip="Reset damage track">
        <i class="fa-item fas fa-sync"></i>
      </a>
    </span>
  </div>

  <div class="damage-horizontal">
    <label>
      <input type="radio" name="damageTrack" value="hale" {{checked (eq system.core.damageTrack "hale")}} />
      Hale
    </label>

    <label>
      <input type="radio" name="damageTrack" value="impaired" {{checked (eq system.core.damageTrack "impaired")}} />
      Impaired
    </label>

    <label>
      <input
        type="radio"
        name="damageTrack"
        value="debilitated"
        {{checked (eq system.core.damageTrack "debilitated")}}
      />
      Debilitated
    </label>

    <label>
      <input type="radio" name="damageTrack" value="dead" {{checked (eq system.core.damageTrack "dead")}} />
      Dead
    </label>
  </div>
</section>