<div class="cypher-bio-grid">
  <!-- Row 1 -->
  <div class="bio-cell bio-name floating">
    <input type="text" name="name" value="{{actor.name}}" />
    <label>
      NAME
    </label>
  </div>

  <div class="bio-cell bio-is-a">
    IS A
  </div>

  <div class="bio-cell bio-descriptor floating">
    <input type="text" name="system.bio.descriptor" value="{{system.bio.descriptor}}" />
    <label>
      DESCRIPTOR
    </label>
  </div>

  <!-- Row 2 -->
  <div class="bio-cell bio-type floating">
    <input type="text" name="system.bio.type" value="{{system.bio.type}}" />
    <label>
      TYPE (FLAVOR)
    </label>
  </div>

  <div class="bio-cell bio-who">
    WHO
  </div>

  <div class="bio-cell bio-focus floating">
    <input type="text" name="system.bio.focus" value="{{system.bio.focus}}" />
    <label>
      FOCUS
    </label>
  </div>
</div>