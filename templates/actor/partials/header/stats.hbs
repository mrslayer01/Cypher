<div class="cypher-header-stats">
    {{! MIGHT }}
    <div class="stat-block">
        <div class="stat-title">MIGHT</div>

        <!-- Max -->
        <div class="stat-max-display">
            <div class="floating max">
                <input type="number" name="system.core.pools.might.max" value="{{system.core.pools.might.max}}" />
                <label>Max</label>
            </div>
        </div>

        <!-- Current + Edge -->
        <div class="stat-row">
            <div class="floating pool">
                <input type="number" name="system.core.pools.might.current" value="{{system.core.pools.might.current}}" />
                <label>Pool</label>
            </div>
            <span class="stat-separator">|</span>
            <div class="floating pool">
                <input type="number" name="system.core.pools.might.edge.current" value="{{system.core.pools.might.edge.current}}" />
                <label>Edge</label>
            </div>
        </div>
        <!-- Defense -->
        <div class="defense-row">
            <div class="def-label">DEFENSE</div>

            <div class="def-grid">
                <div class="def-col">
                <span class="def-letter">I</span>
                <input type="radio" name="mightDefense" value="inability"
                    {{#if system.core.pools.might.defense.inability}}checked{{/if}} />
                </div>

                <div class="def-col">
                <span class="def-letter">P</span>
                <input type="radio" name="mightDefense" value="practiced"
                    {{#if system.core.pools.might.defense.practiced}}checked{{/if}} />
                </div>

                <div class="def-col">
                <span class="def-letter">T</span>
                <input type="radio" name="mightDefense" value="trained"
                    {{#if system.core.pools.might.defense.trained}}checked{{/if}} />
                </div>

                <div class="def-col">
                <span class="def-letter">S</span>
                <input type="radio" name="mightDefense" value="specialized"
                    {{#if system.core.pools.might.defense.specialized}}checked{{/if}} />
                </div>
            </div>
        </div>
    </div>

