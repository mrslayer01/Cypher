<div class="cypher-main-grid">
  <section class="cypher-section cyphers-section item-drop-area" data-table="equipment">
    <h3 class="equipment-grid">
      Equipment
      <a class="add-equipment" data-tooltip="Add new piece of Equipment">
        <i class="fas fa-plus-circle"></i>
      </a>
      <div class="floating pool">
        <input
          type="number"
          name="system.core.equipment.money"
          class="no-negative"
          value="{{system.core.equipment.money}}"
        />
        <label>
          Shins
        </label>
      </div>
    </h3>
    <table>
      <thead>
        <tr>
          <th>
            Name
          </th>
          <th>
            Quantity
          </th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each equipment}}
          <tr>
            <td>
              <a class="view-item" data-item-id="{{this.id}}">
                {{this.name}}
              </a>
            </td>
            <td>
              {{this.system.quantity}}
            </td>
            <td>
              <a class="delete-equipment" data-item-id="{{this.id}}">
                <i class="fas fa-trash"></i>
              </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  {{! ========================= }}
  {{!  ROW 1 — COLUMN 1: ARMOR }}
  {{! ========================= }}
  <section class="cypher-section armor-section item-drop-area" data-table="armor">
    <h3>
      Armor
      <a class="add-armor" data-tooltip="Add new armor">
        <i class="fas fa-plus-circle"></i>
      </a>
    </h3>

    <table>
      <thead>
        <tr>
          <th>
            Name
          </th>
          <th>
            Type
          </th>
          <th>
            Armor
          </th>
          <th>
            Equipped
          </th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each armor}}
          <tr>
            <td>
              <a class="view-item" data-item-id="{{this.id}}">
                {{this.name}}
              </a>
            </td>
            <td>
              {{this.system.armor.type}}
            </td>
            <td>
              {{sum this.system.armor.armor.base this.system.armor.armor.bonus}}
            </td>
            <td>
              <input
                type="checkbox"
                data-item-id="{{this.id}}"
                data-field="equipped"
                {{checked this.system.armor.equipped}}
              />
            </td>
            <td>
              <a class="delete-armor" data-item-id="{{this.id}}">
                <i class="fas fa-trash"></i>
              </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  {{! ========================== }}
  {{!  ROW 1 — COLUMN 2: Weapons }}
  {{! ========================== }}
  <section class="cypher-section attacks-section item-drop-area" data-table="weapons">
    <h3>
      Weapons
      <a class="add-weapon" data-tooltip="Add new weapon">
        <i class="fas fa-plus-circle"></i>
      </a>
    </h3>

    <table>
      <thead>
        <tr>
          <th></th>
          <th>
            Name
          </th>
          <th>
            Class
          </th>
          <th>
            Type
          </th>
          <th>
            Pool
          </th>
          <th>
            Skill
          </th>
          <th>
            Damage
          </th>
          <th>
            Equipped
          </th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each weapon}}
          <tr>
            <td>
              <a class="weapon-attack-roll" data-item="{{this.id}}" data-tooltip="Make attack roll">
                <i class="fa-solid fa-dice-d20"></i>
              </a>
            </td>
            <td>
              <a class="view-item" data-item-id="{{this.id}}">
                {{this.name}}
              </a>
            </td>
            <td>
              {{this.system.weapon.type}}
            </td>
            <td>
              {{this.system.weapon.weaponType}}
            </td>
            <td>
              {{this.system.weapon.attack.pool}}
            </td>
            <td>
              {{this.system.weapon.attack.skill}}
            </td>
            <td>
              {{sum this.system.weapon.damage.base this.system.weapon.damage.bonus}}
            </td>
            <td>
              <input
                type="checkbox"
                data-item-id="{{this.id}}"
                data-field="equipped"
                {{checked this.system.weapon.equipped}}
              />
            </td>
            <td>
              <a class="delete-weapon" data-item-id="{{this.id}}">
                <i class="fas fa-trash"></i>
              </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  {{! ========================== }}
  {{!  ROW 2 — COLUMN 2: CYPHERS }}
  {{! ========================== }}
  <section class="cypher-section cyphers-section item-drop-area" data-table="cyphers">
    <h3 class="equipment-grid">
      Cyphers
      <a class="add-cypher" data-tooltip="Add new cypher">
        <i class="fas fa-plus-circle"></i>
      </a>
      <div class="floating pool">
        <input
          type="number"
          name="system.core.cyphers.limit"
          class="no-negative"
          value="{{system.core.cyphers.limit}}"
        />
        <label>
          Limit
        </label>
      </div>
    </h3>

    <table>
      <thead>
        <tr>
          <th>
            Name
          </th>
          <th>
            Level
          </th>
          <th>
            Depleted
          </th>
          <th>
            Active
          </th>
          <th>
            Favorite
          </th>
          <th></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each cyphers}}
          <tr>
            <td>
              <a class="view-item" data-item-id="{{this.id}}">
                {{#if (not system.cypher.identified)}}
                  Unidentified Item
                {{else}}
                  {{this.name}}
                {{/if}}
              </a>
            </td>
            <td>
              {{#if (not system.cypher.identified)}}
                ??
              {{else}}
                {{this.system.cypher.level.current}}
              {{/if}}
            </td>
            <td>
              {{#if (not system.cypher.identified)}}
              {{else}}
                {{#if this.system.cypher.depleted}}
                  <i class="fas fa-check"></i>
                {{else}}
                  <i class="fas fa-times"></i>
                {{/if}}
              {{/if}}
            </td>
            <td>
              {{#if (not system.cypher.identified)}}
              {{else}}
                <input
                  type="checkbox"
                  data-item-id="{{this.id}}"
                  data-field="active"
                  {{checked this.system.cypher.active}}
                />
              {{/if}}
            </td>
            <td>
              {{#if (not system.cypher.identified)}}
              {{else}}
                <input
                  type="checkbox"
                  data-item-id="{{this.id}}"
                  data-field="favorite"
                  {{checked this.system.cypher.favorite}}
                />
              {{/if}}
            </td>
            <td>
              <a class="delete-cypher" data-item-id="{{this.id}}">
                <i class="fas fa-trash"></i>
              </a>
            </td>
            <td>
              <a class="trade-cypher" data-item-id="{{this.id}}" data-tooltip="Give cypher to another character">
                <i class="fas fa-exchange-alt"></i>
              </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </section>
</div>