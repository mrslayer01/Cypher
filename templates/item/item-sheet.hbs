<form class="item-sheet" autocomplete="off">
  <header class="sheet-header">
    <h1>
      {{item.name}}
    </h1>
  </header>

  <section class="sheet-body">
    <div class="stat-block">
      <label>
        Description
      </label>
      <textarea name="system.bio.description">
        {{system.description}}
      </textarea>
    </div>
  </section>
</form>