<form class="item-sheet" autocomplete="off">
  <header class="sheet-header">
    <div class="item-header">
        <div class="item-header-top flexrow">
          <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>

          <div class="item-header-fields">
            <h1 class="item-name">
              {{#if (and (eq item.type "Cypher") (not system.cypher.identified))}}
                <input type="text" name="name" value="Unidentified Item" placeholder="Item Name" disabled="true"/>
              {{else}}
                <input type="text" name="name" value="{{item.name}}" placeholder="Item Name"/>
              {{/if}}
            </h1>
          </div>

          <div class="item-header-fields-small">
            {{#if (and (eq item.type "Cypher") isGM)}}
              <a class="gm-identify-cypher">
                {{#if this.system.cypher.identified}}
                  <i class="fa fa-eye" data-tooltip="Click to de-identify"></i>
                {{else}}
                  <i class="fa-solid fa-eye-closed" data-tooltip="Click to identify"></i>
                {{/if}}            
              </a>
            {{/if}}
          </div>
        </div>
          {{#if (in item.type "Equipment" "Weapon" "Armor")}}
            {{> item-equipment-header}}
          {{/if}}
          {{#if (in item.type "Weapon")}}
            {{> item-weapon-header}}
          {{/if}}
          {{#if (in item.type "Armor")}}
            {{> item-armor-header}}
          {{/if}}
          {{#if (in item.type "Attack")}}
            {{> item-attack-header}}
          {{/if}}
          {{#if (in item.type "Cypher")}}
            {{> item-cypher-header}}
          {{/if}}
          {{#if (in item.type "Skill")}}
            {{> item-skill-header}}
          {{/if}}
          {{#if (in item.type "Special Ability")}}
            {{> item-special-header}}
          {{/if}}
          {{#if (in item.type "Character Arc")}}
            {{> item-arc-header}}
          {{/if}}
    </div>
  </header>

  <nav class="sheet-tabs" data-group="primary">
    {{#if (in item.type "Character Arc")}}
      <a class="item" data-tab="main">
        Main
      </a>
      <a class="item" data-tab="steps">
        Steps
      </a>
    {{/if}}
    <a class="item" data-tab="description">
      Description
    </a>
  </nav>

  <section class="sheet-body">
    {{#if (in item.type "Character Arc")}}
      <div class="tab main" data-group="primary" data-tab="main">
        {{> item-arc-main}}
      </div>
      <div class="tab steps" data-group="primary" data-tab="steps">
        {{> item-arc-steps}}
      </div>
    {{/if}}

    <div class="tab description" data-group="primary" data-tab="description">
      <div class="description-editor">
        {{#if (and (eq item.type "Cypher") (not system.cypher.identified))}}
          <div class="cypher-description-obscured">
            <div class="cypher-description-overlay">
              <span>Unidentified Cypher</span>
              <p>The description is obscured until this cypher is identified.</p>
            </div>
          </div>
        {{else}}
          {{#if system.itemDescription}}
            {{editor
              system.itemDescription
              target="system.itemDescription"
              button=true
              editable=true
              engine="prosemirror"
            }}
          {{else}}
            {{editor
              "<p class='placeholder'>Item Description</p>"
              target="system.itemDescription"
              button=true
              editable=true
              engine="prosemirror"
            }}
          {{/if}}
        {{/if}}
      </div>
    </div>
  </section>
</form>