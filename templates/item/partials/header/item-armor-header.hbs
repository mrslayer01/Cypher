<div class="armor-info-grid">
  <!-- Armor Type -->
  <div class="field">
    <label>Armor Type</label>
    <select name="system.armor.type" class="armor-type">
      <option value="Light"  {{#if (eq system.armor.type "Light")}}selected{{/if}}>Light</option>
      <option value="Medium" {{#if (eq system.armor.type "Medium")}}selected{{/if}}>Medium</option>
      <option value="Heavy"  {{#if (eq system.armor.type "Heavy")}}selected{{/if}}>Heavy</option>
      <option value="Shield"  {{#if (eq system.armor.type "Shield")}}selected{{/if}}>Shield</option>
      <option value="Extra"  {{#if (eq system.armor.type "Extra")}}selected{{/if}}>Extra</option>
    </select>
  </div>

    <!-- Attack Skill -->
  <div class="field">
      <label>Armor Skill</label>
      <select name="system.armor.skill">
          <option value="Practiced"     {{#if (eq system.armor.skill "Practiced")}}selected{{/if}}>Practiced</option>
          <option value="Trained"     {{#if (eq system.armor.skill "Trained")}}selected{{/if}}>Trained</option>
          <option value="Specialized" {{#if (eq system.armor.skill "Specialized")}}selected{{/if}}>Specialized</option>
          <option value="Inability" {{#if (eq system.armor.skill "Inability")}}selected{{/if}}>Inability</option>
      </select>
  </div>

  <!-- Base Armor -->
  <div class="field">
    <label>Base Armor</label>
    <input type="number"
           name="system.armor.armor.base"
           value="{{system.armor.armor.base}}"
           disabled="true"
           class="no-negative" />
  </div>

  <!-- Bonus Armor -->
  <div class="field">
    <label>Bonus Armor</label>
    <input type="number"
           name="system.armor.armor.bonus"
           value="{{system.armor.armor.bonus}}"
           class="no-negative" />
  </div>

    <!-- Effort Reduction -->
  <div class="field">
    <label>Effort Reduc</label>
    <input type="number"
           name="system.armor.effortReduc"
           value="{{system.armor.effortReduc}}"
           class="no-negative" />
  </div>
</div>
