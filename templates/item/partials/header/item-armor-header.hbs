<div class="armor-info-grid">
  <!-- Armor Type -->
  <div class="field">
    <label>Armor Type</label>
    <select name="system.armor.type">
      <option value="Light"  {{#if (eq system.armor.type "Light")}}selected{{/if}}>Light</option>
      <option value="Medium" {{#if (eq system.armor.type "Medium")}}selected{{/if}}>Medium</option>
      <option value="Heavy"  {{#if (eq system.armor.type "Heavy")}}selected{{/if}}>Heavy</option>
    </select>
  </div>

  <!-- Shield -->
  <div class="field">
    <label>Shield</label>
    <input type="checkbox"
           name="system.armor.shield"
           {{#if system.armor.shield}}checked{{/if}} />
  </div>

  <!-- Pool Penalty -->
  <div class="field">
    <label>Pool Penalty</label>
    <select name="system.armor.mod.pool">
      <option value="might"     {{#if (eq system.armor.mod.pool "might")}}selected{{/if}}>Might</option>
      <option value="speed"     {{#if (eq system.armor.mod.pool "speed")}}selected{{/if}}>Speed</option>
      <option value="intellect" {{#if (eq system.armor.mod.pool "intellect")}}selected{{/if}}>Intellect</option>
    </select>
  </div>

  <!-- Extra Effort Cost -->
  <div class="field">
    <label>Extra Effort Cost</label>
    <input type="number"
           name="system.armor.mod.extraEffort"
           value="{{system.armor.mod.extraEffort}}"
           class="no-negative" />
  </div>

  <!-- Base Armor -->
  <div class="field">
    <label>Base Armor</label>
    <input type="number"
           name="system.armor.armor.base"
           value="{{system.armor.armor.base}}"
           class="no-negative" />
  </div>

  <!-- Bonus Armor -->
  <div class="field">
    <label>Bonus Armor</label>
    <input type="number"
           name="system.armor.armor.bonus"
           value="{{system.armor.armor.bonus}}"
           class="no-negative" />
  </div>
</div>
