<div class="cypher-info-grid">
  <!-- Cypher Type -->
  <div class="field">
    <label>Type</label>
    <select name="system.cypher.type">
      <option value="Cypher"   {{#if (eq system.cypher.type "Cypher")}}selected{{/if}}>Cypher</option>
      <option value="Artifact" {{#if (eq system.cypher.type "Artifact")}}selected{{/if}}>Artifact</option>
    </select>
  </div>

  <!-- Level Current -->
  <div class="field">
    <label>
        <a class="cypher-level-roll clickable" data-tooltip="Click to roll Cypher/Artifact level">
            Level
        </a>
    </label>
    <input type="number"
           name="system.cypher.level.current"
           value="{{system.cypher.level.current}}"
           class="no-negative" />
  </div>



  {{#if (eq system.cypher.type "Artifact")}}
    <!-- Depletion Dice + Modifier -->

    <div class="field depletion-dice-wrapper">
      <span>
        <a class="cypher-depletion-roll clickable" data-tooltip="Click to roll Artifact Depletion">
          Depletion Roll
        </a>
      </span>
      <input type="checkbox"
      name="system.cypher.depleted"
      data-tooltip="Depleted?"
      {{#if system.cypher.depleted}}checked{{/if}} />
    </div>
  {{/if}}

</div>
