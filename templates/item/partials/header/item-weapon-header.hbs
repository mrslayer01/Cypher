<!-- Weapon Info Grid -->
<div class="weapon-info-grid">
    <!-- Weapon Type -->
    <div class="field">
        <label>Weapon Class</label>
        <select name="system.weapon.type" class="weapon-type">
        <option value="Light"   {{#if (eq system.weapon.type "Light")}}selected{{/if}}>Light</option>
        <option value="Medium"  {{#if (eq system.weapon.type "Medium")}}selected{{/if}}>Medium</option>
        <option value="Heavy"   {{#if (eq system.weapon.type "Heavy")}}selected{{/if}}>Heavy</option>
        <option value="Special"   {{#if (eq system.weapon.type "Special")}}selected{{/if}}>Special</option>
        </select>
    </div>

    <!-- Weapon Type Pool -->
    <div class="field">
        <label>Weapon Type</label>
        <select name="system.weapon.weaponType">
        <option value="Slashing"     {{#if (eq system.weapon.weaponType "Slashing")}}selected{{/if}}>Slashing</option>
        <option value="Piercing"     {{#if (eq system.weapon.weaponType "Piercing")}}selected{{/if}}>Piercing</option>
        <option value="Crushing" {{#if (eq system.weapon.weaponType "Crushing")}}selected{{/if}}>Crushing</option>
        <option value="Reaching" {{#if (eq system.weapon.weaponType "Reaching")}}selected{{/if}}>Reaching</option>
        <option value="Special" {{#if (eq system.weapon.weaponType "Special")}}selected{{/if}}>Special</option>
        </select>
    </div>

    <!-- Attack Pool -->
    <div class="field">
        <label>Attack Pool</label>
        <select name="system.weapon.attack.pool">
        <option value="Might"     {{#if (eq system.weapon.attack.pool "Might")}}selected{{/if}}>Might</option>
        <option value="Speed"     {{#if (eq system.weapon.attack.pool "Speed")}}selected{{/if}}>Speed</option>
        <option value="Intellect" {{#if (eq system.weapon.attack.pool "Intellect")}}selected{{/if}}>Intellect</option>
        </select>
    </div>

    <!-- Attack Skill -->
    <div class="field">
        <label>Attack Skill</label>
        <select name="system.weapon.attack.skill">
            <option value="Practiced"     {{#if (eq system.weapon.attack.skill "Practiced")}}selected{{/if}}>Practiced</option>
            <option value="Trained"     {{#if (eq system.weapon.attack.skill "Trained")}}selected{{/if}}>Trained</option>
            <option value="Specialized" {{#if (eq system.weapon.attack.skill "Specialized")}}selected{{/if}}>Specialized</option>
            <option value="Inability" {{#if (eq system.weapon.attack.skill "Inability")}}selected{{/if}}>Inability</option>
        </select>
    </div>

    <!-- Damage Base -->
    <div class="field">
        <label>Base Damage</label>
        <input type="number"
                name="system.weapon.damage.base"
                value="{{system.weapon.damage.base}}"
                class="no-negative"
                disabled="true"/>
    </div>

    <!-- Damage Bonus -->
    <div class="field">
        <label>Bonus Damage</label>
        <input type="number"
                name="system.weapon.damage.bonus"
                value="{{system.weapon.damage.bonus}}"
                class="no-negative"/>
    </div>
</div>
